<!--
    XPOTIFY FORK: Spotify-desktop-style palette and styles. Merged after Themes/Win11.xaml
    when XpotifyLayout is enabled (App.ApplyThemeResources). The shell forces Dark theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="XpotifyBaseColor">#FF000000</Color>
    <Color x:Key="XpotifyPanelColor">#FF121212</Color>
    <Color x:Key="XpotifyElevatedColor">#FF1F1F1F</Color>
    <Color x:Key="XpotifyHighlightColor">#FF2A2A2A</Color>
    <Color x:Key="XpotifyAccentColor">#FF1ED760</Color>
    <Color x:Key="XpotifySubtleTextColor">#FFB3B3B3</Color>

    <SolidColorBrush x:Key="XpotifyBaseBrush" Color="{StaticResource XpotifyBaseColor}" />
    <SolidColorBrush x:Key="XpotifyPanelBrush" Color="{StaticResource XpotifyPanelColor}" />
    <SolidColorBrush x:Key="XpotifyElevatedBrush" Color="{StaticResource XpotifyElevatedColor}" />
    <SolidColorBrush x:Key="XpotifyHighlightBrush" Color="{StaticResource XpotifyHighlightColor}" />
    <SolidColorBrush x:Key="XpotifyAccentBrush" Color="{StaticResource XpotifyAccentColor}" />
    <SolidColorBrush x:Key="XpotifySubtleTextBrush" Color="{StaticResource XpotifySubtleTextColor}" />

    <LinearGradientBrush x:Key="XpotifyLikedSongsBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF4B2BD6" />
        <GradientStop Offset="1" Color="#FF9DB8D9" />
    </LinearGradientBrush>

    <!-- Accent: WinUI 2 controls (sliders, toggles, selection) read these. -->
    <Color x:Key="SystemAccentColor">#FF1ED760</Color>
    <Color x:Key="SystemAccentColorLight1">#FF3BE477</Color>
    <Color x:Key="SystemAccentColorLight2">#FF1ED760</Color>
    <Color x:Key="SystemAccentColorLight3">#FF7DEBA3</Color>
    <Color x:Key="SystemAccentColorDark1">#FF1AB852</Color>
    <Color x:Key="SystemAccentColorDark2">#FF169C46</Color>
    <Color x:Key="SystemAccentColorDark3">#FF117A37</Color>

    <!-- Shared shell brushes that upstream controls already reference. -->
    <SolidColorBrush x:Key="AppBackgroundAcrylic" Color="{StaticResource XpotifyPanelColor}" />
    <SolidColorBrush x:Key="MediaBarBackgroundBrush" Color="{StaticResource XpotifyBaseColor}" />

    <!-- Panels: near-black rounded cards on a black window, as in the desktop app. -->
    <Style x:Key="XpotifyPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource XpotifyPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="XpotifySectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="XpotifySubtleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource XpotifySubtleTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Round icon button used in the top bar (Home, Settings, panels). -->
    <Style x:Key="XpotifyRoundButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource XpotifySubtleTextBrush}" />
        <Setter Property="Background" Value="{StaticResource XpotifyElevatedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                        <ContentPresenter
                            x:Name="Presenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Circle.Fill" Value="{StaticResource XpotifyHighlightBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Circle.Fill" Value="{StaticResource XpotifyElevatedBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="White" />
                                        <Setter Target="Root.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The player bar's play/pause: white circle, black glyph. Applied by XpotifyShellPage. -->
    <Style x:Key="XpotifyPlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8,0,16,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="White" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Scale.ScaleX" Value="1.06" />
                                        <Setter Target="Scale.ScaleY" Value="1.06" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Scale.ScaleX" Value="0.95" />
                                        <Setter Target="Scale.ScaleY" Value="0.95" />
                                        <Setter Target="Root.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Library rows: flat, rounded highlight on hover/selection. -->
    <Style x:Key="XpotifyLibraryItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Pill search box. -->
    <Style x:Key="XpotifySearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
