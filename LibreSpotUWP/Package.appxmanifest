<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap mp uap3">

  <Identity
    Name="PrismFox67.XpotifyUWP"
    Publisher="CN=PrismFox67"
    Version="1.1.8.1" />

  <mp:PhoneIdentity PhoneProductId="591b16c8-1467-4452-913d-20d8fb1eb1fa"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Xpotify UWP</DisplayName>
    <PublisherDisplayName>PrismFox67 (fork of Spotbox / LibreSpotUWP by MegaBytesMe)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.17763.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="LibreSpotUWP.App">

      <uap:VisualElements
        DisplayName="Xpotify UWP"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Xpotify UWP: an Xbox Dev Mode build of LibreSpotUWP (by MegaBytesMe), a Spotify client powered by librespot."
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Xpotify UWP"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>

      <Extensions>
         <uap:Extension Category="windows.protocol">
            <uap:Protocol Name="librespotuwp">
               <uap:DisplayName>LibreSpotUWP</uap:DisplayName>
            </uap:Protocol>
         </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <uap3:Capability Name="backgroundMediaPlayback"/>
    <DeviceCapability Name="webcam"/>
  </Capabilities>
</Package>













